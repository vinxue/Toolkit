<Window x:Class="Nexus.PopupWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nexus"
        Width="1180"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="PopupRoot" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="PopupAddressBar"
                Grid.Row="0"
                Background="#F6F8FB"
                BorderBrush="#D8DEE8"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Visibility="Collapsed">
            <Border HorizontalAlignment="Stretch"
                    Background="#E8EDF5"
                    CornerRadius="10"
                    Padding="1">
                <Grid>
                    <TextBox x:Name="PopupAddressBox"
                             Style="{StaticResource TemporaryAddressTextBox}"
                             Height="38"
                             TextChanged="PopupAddressBox_TextChanged"
                             KeyDown="PopupAddressBox_KeyDown" />
                    <TextBlock x:Name="PopupAddressPlaceholderText"
                               Text="Enter web address"
                               Foreground="#6B7280"
                               FontSize="14"
                               Margin="13,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Border>

        <wv2:WebView2 x:Name="PopupWebView"
                      Grid.Row="1"
                      PreviewKeyDown="PopupWebView_PreviewKeyDown" />
    </Grid>
</Window>
