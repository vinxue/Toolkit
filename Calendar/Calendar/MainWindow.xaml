<Window x:Class="CalendarApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar"
        Width="700" Height="520"
        MinWidth="400" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ContextMenu x:Key="TrayMenu" FontSize="12">
            <MenuItem Header="Open Calendar" Click="TrayOpen_Click" />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </ContextMenu>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="WeekdayHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DayGridStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCellStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="2" Background="Transparent">
                            <Border x:Name="Fill" CornerRadius="6" />
                            <Border x:Name="Ring"
                                    CornerRadius="6"
                                    BorderThickness="1.5"
                                    BorderBrush="Transparent"
                                    IsHitTestVisible="False" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="Num"
                                           Text="{Binding Day}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="Sub"
                                           Text="{Binding SubText}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsToday}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsToday}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Fill" Property="Opacity" Value="0.85" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="Transparent" MouseLeftButtonDown="Content_MouseLeftButtonDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="TitleButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Margin="-11,0,0,0"
                        Style="{StaticResource SubtleButton}"
                        Padding="10,4"
                        Click="TitleButton_Click"
                        AutomationProperties.Name="Select year and month">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="10,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="PinButton"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButton}"
                        Width="36" Height="32"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="PinButton_Click"
                        AutomationProperties.Name="Unpin window">
                    <TextBlock Text="&#xE718;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Button>

                <Button x:Name="TodayButton"
                        Grid.Column="2"
                        Style="{StaticResource OutlineButton}"
                        Height="32"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Content="今天"
                        Padding="10,0"
                        Margin="0,0,4,0"
                        Click="TodayButton_Click" />
                <Button Grid.Column="3"
                        Style="{StaticResource SubtleButton}"
                        Width="36" Height="32"
                        VerticalAlignment="Center"
                        Click="PrevMonth_Click"
                        AutomationProperties.Name="Previous month">
                    <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>
                <Button Grid.Column="4"
                        Style="{StaticResource SubtleButton}"
                        Width="36" Height="32"
                        VerticalAlignment="Center"
                        Click="NextMonth_Click"
                        AutomationProperties.Name="Next month">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>
                <Button x:Name="MoreButton"
                        Grid.Column="5"
                        Style="{StaticResource SubtleButton}"
                        Width="36" Height="32"
                        VerticalAlignment="Center"
                        ToolTip="More"
                        ContextMenuService.Placement="Bottom"
                        Click="MoreButton_Click"
                        AutomationProperties.Name="More">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" FontSize="14" Placement="Bottom" Opened="MoreMenu_Opened">
                            <MenuItem x:Name="PinMenuItem" IsCheckable="True" Click="PinMenuItem_Click" AutomationProperties.Name="Always on top">
                                <MenuItem.Header>
                                    <!-- The theme bottom-aligns InputGestureText; one TextBlock keeps the shortcut on the label's baseline. -->
                                    <TextBlock>
                                        <Run Text="Always on top" /><Run Text="      Ctrl+P" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem x:Name="AutoStartMenuItem" IsCheckable="True" Click="AutoStart_Click" AutomationProperties.Name="Run at startup">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="Run at startup" /><Run x:Name="AutoStartSuffixRun" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Exit" Click="Exit_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Popup x:Name="PickerPopup"
                       PlacementTarget="{Binding ElementName=TitleButton}"
                       Placement="Bottom"
                       HorizontalOffset="-12"
                       VerticalOffset="-12"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Margin="20"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource ContentDialogBackground}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Width="264">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.25" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SubtleButton}" Width="32" Height="32" Click="PickerPrevYear_Click" AutomationProperties.Name="Previous year">
                                    <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <TextBlock x:Name="PickerYearText" Grid.Column="1" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Width="32" Height="32" Click="PickerNextYear_Click" AutomationProperties.Name="Next year">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </Grid>
                            <ItemsControl x:Name="PickerMonths">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PickerButton}"
                                                Tag="{Binding Value}"
                                                Height="44"
                                                Margin="1"
                                                Content="{Binding Value}"
                                                ContentStringFormat="{}{0}月"
                                                Click="PickerMonth_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid Grid.Row="1" Background="Transparent" PreviewMouseWheel="CalendarGrid_PreviewMouseWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="周" Style="{StaticResource WeekdayHeader}" />
                <UniformGrid Grid.Row="0" Grid.Column="1" Columns="7">
                    <TextBlock Text="日" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="一" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="二" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="三" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="四" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="五" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="六" Style="{StaticResource WeekdayHeader}" />
                </UniformGrid>

                <Grid x:Name="BodyViewport" Grid.Row="1" Grid.ColumnSpan="2" Background="Transparent" ClipToBounds="True">
                    <Image x:Name="OutgoingImage"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Stretch="None"
                           IsHitTestVisible="False">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="OutgoingShift" />
                        </Image.RenderTransform>
                    </Image>
                    <Grid x:Name="BodyHost">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="BodyShift" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ItemsControl x:Name="WeekList" Grid.Column="0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" Rows="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="WeekNumberText"
                                               Text="{Binding Number}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="WeekNumberText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <Setter TargetName="WeekNumberText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ListBox x:Name="DayList"
                                 Grid.Column="1"
                                 Style="{StaticResource DayGridStyle}"
                                 ItemContainerStyle="{StaticResource DayCellStyle}"
                                 SelectionMode="Single"
                                 SelectionChanged="DayList_SelectionChanged" />
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Grid.Column="0"
                        Width="1"
                        Margin="0,6"
                        HorizontalAlignment="Right"
                        IsHitTestVisible="False"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            </Grid>

            <!-- Shown instead of the detail pane's clock when the window is too narrow for the pane. -->
            <Border x:Name="CompactClock"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="0,10,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactClockText"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="CompactClockSuffix"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,3"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CompactShichen"
                               Grid.Column="1"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource SubtleButton}"
                            Width="36" Height="32"
                            VerticalAlignment="Center"
                            ToolTip="World Clock"
                            Click="WorldClock_Click"
                            AutomationProperties.Name="World Clock">
                        <TextBlock Text="&#xE909;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="DetailPane"
                Grid.Column="1"
                Width="240"
                Margin="20,0,0,0"
                Padding="20,0,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="DetailDate" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailWeekday" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="周数" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailWeek" Style="{StaticResource InfoValue}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="全年" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailDayOfYear" Style="{StaticResource InfoValue}" />
                </Grid>

                <Border Height="1" Margin="0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <TextBlock x:Name="DetailLunarDay" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailLunarYear" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="干支" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailGanZhi" Style="{StaticResource InfoValue}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="DetailFestivalLabel" Text="节日" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailFestival" Style="{StaticResource InfoValue}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="DetailSolarTermLabel" Text="节气" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailSolarTerm" Style="{StaticResource InfoValue}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Border Height="1" Margin="0,0,0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClockText"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="ClockSuffix"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,7"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="ClockShichen" FontSize="13" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource SubtleButton}"
                            Width="36" Height="32"
                            VerticalAlignment="Center"
                            ToolTip="World Clock"
                            Click="WorldClock_Click"
                            AutomationProperties.Name="World Clock">
                        <TextBlock Text="&#xE909;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
