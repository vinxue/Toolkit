<Window x:Class="Calendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar"
        Width="780" Height="580"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <ContextMenu x:Key="TrayMenu" FontSize="12">
            <MenuItem Header="Open Calendar" Click="TrayOpen_Click" />
            <MenuItem Header="Exit" Click="TrayExit_Click" />
        </ContextMenu>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="WeekdayHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DayGridStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCellStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring"
                                Margin="1"
                                Padding="1"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                CornerRadius="6"
                                Background="Transparent">
                            <Border x:Name="Fill" CornerRadius="4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Num"
                                               Text="{Binding Day}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="Sub"
                                               Text="{Binding SubText}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="Transparent" MouseLeftButtonDown="Content_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="TitleButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Margin="-11,0,0,0"
                        Style="{StaticResource SubtleButton}"
                        Padding="10,4"
                        Click="TitleButton_Click"
                        AutomationProperties.Name="选择年月">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="10,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="PinButton"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButton}"
                        Width="36" Height="32"
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        Click="PinButton_Click"
                        AutomationProperties.Name="取消置顶">
                    <TextBlock Text="&#xE718;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Button>

                <Button x:Name="TodayButton"
                        Grid.Column="2"
                        Style="{StaticResource SubtleButton}"
                        Content="今天"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="TodayButton_Click" />
                <Button Grid.Column="3"
                        Style="{StaticResource SubtleButton}"
                        Width="36" Height="32"
                        Click="PrevMonth_Click"
                        AutomationProperties.Name="上个月">
                    <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>
                <Button Grid.Column="4"
                        Style="{StaticResource SubtleButton}"
                        Width="36" Height="32"
                        Click="NextMonth_Click"
                        AutomationProperties.Name="下个月">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>

                <Popup x:Name="PickerPopup"
                       PlacementTarget="{Binding ElementName=TitleButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Margin="8"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource ContentDialogBackground}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Width="264">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SubtleButton}" Width="32" Height="32" Click="PickerPrevYear_Click" AutomationProperties.Name="上一年">
                                    <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <TextBlock x:Name="PickerYearText" Grid.Column="1" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Width="32" Height="32" Click="PickerNextYear_Click" AutomationProperties.Name="下一年">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </Grid>
                            <ItemsControl x:Name="PickerMonths">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButton}"
                                                Tag="{Binding}"
                                                Height="44"
                                                Margin="1"
                                                Content="{Binding}"
                                                ContentStringFormat="{}{0}月"
                                                Click="PickerMonth_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid x:Name="BodyHost" Grid.Row="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="BodyShift" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="W" Style="{StaticResource WeekdayHeader}" />
                <UniformGrid Grid.Row="0" Grid.Column="1" Columns="7">
                    <TextBlock Text="日" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="一" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="二" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="三" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="四" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="五" Style="{StaticResource WeekdayHeader}" />
                    <TextBlock Text="六" Style="{StaticResource WeekdayHeader}" />
                </UniformGrid>

                <ItemsControl x:Name="WeekList" Grid.Row="1" Grid.Column="0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="WeekNumberText"
                                       Text="{Binding Number}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="WeekNumberText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="WeekNumberText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Grid.Column="0"
                        Width="1"
                        Margin="0,6"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <ListBox x:Name="DayList"
                         Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource DayGridStyle}"
                         ItemContainerStyle="{StaticResource DayCellStyle}"
                         SelectionMode="Single"
                         SelectionChanged="DayList_SelectionChanged" />
            </Grid>
        </Grid>

        <Border x:Name="DetailPane"
                Grid.Column="1"
                Width="264"
                Margin="20,0,0,0"
                Padding="20,0,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="DetailDate" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailWeekday" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Height="1" Margin="0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <TextBlock x:Name="DetailLunarDay" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailLunarYear" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border x:Name="DetailTagPanel"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Padding="8,2"
                        CornerRadius="4"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="DetailTags"
                               FontSize="13"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>

                <Border Height="1" Margin="0,16,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="周数" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailWeek" Style="{StaticResource InfoValue}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="全年" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailDayOfYear" Style="{StaticResource InfoValue}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Border Height="1" Margin="0,0,0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ClockText"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="ClockSuffix"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Bottom"
                               Margin="6,0,0,7"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
