<Window x:Class="Nexus.PopupWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nexus"
        Width="1180"
        Height="720"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="PopupRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="PopupAddressBar"
                Grid.Row="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="Collapsed">
            <Grid>
                <TextBox x:Name="PopupAddressBox"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         TextChanged="PopupAddressBox_TextChanged"
                         KeyDown="PopupAddressBox_KeyDown" />
                <TextBlock x:Name="PopupAddressPlaceholderText"
                           Text="Enter web address"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="14"
                           Margin="11,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="PopupWebView"
                      Grid.Row="1"
                      PreviewKeyDown="PopupWebView_PreviewKeyDown" />
    </Grid>
</Window>
