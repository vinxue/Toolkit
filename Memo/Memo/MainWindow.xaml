<Window x:Class="Memo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Memo"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Memo"
        Width="500" Height="760" MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,12,0,8" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Meters only carry data while capturing; when idle an empty bar reads as a divider line. -->
        <Style x:Key="LevelMeter" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,8">

                <!-- Timer and transport -->
                <Border Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Recording">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Paused">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Saving">
                                                <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" FontSize="13" />
                        </StackPanel>

                        <TextBlock Text="{Binding Elapsed, StringFormat={}{0:hh\\:mm\\:ss}}"
                                   FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" Margin="0,2,0,16" />

                        <ProgressBar IsIndeterminate="True" Margin="0,0,0,16"
                                     Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    MinWidth="104" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE7C8;" Margin="0,0,8,0" />
                                    <TextBlock Text="Record" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PauseResumeCommand}" MinWidth="88" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE769;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Text" Value="&#xE768;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Pause" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Text" Value="Resume" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" MinWidth="88" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE71A;" Margin="0,0,8,0" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- InfoBar-style message: result of the last action, shown right under the transport controls -->
                <Border CornerRadius="8" BorderThickness="1" Padding="14,10,8,10" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontSize="16" VerticalAlignment="Top" Margin="0,1,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                            <Setter Property="Text" Value="&#xEC61;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                            <Setter Property="Text" Value="&#xEA39;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button DockPanel.Dock="Right" Command="{Binding DismissStatusCommand}" VerticalAlignment="Top"
                                Background="Transparent" BorderBrush="Transparent" Padding="6" Margin="4,-4,0,0" ToolTip="Close">
                            <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE711;" />
                        </Button>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding HasFileActions, Converter={StaticResource BoolToVisibility}}">
                            <Button Command="{Binding OpenLastFileCommand}" Padding="8,5" Margin="0,0,6,0" ToolTip="Play">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE768;" />
                            </Button>
                            <Button Command="{Binding ShowLastFileCommand}" Padding="8,5" ToolTip="Show in File Explorer">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE838;" />
                            </Button>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" Margin="0,0,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusTitle}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Sources" Style="{StaticResource SectionHeader}" />

                <!-- System audio (loopback) -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE7F5;" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="System audio" />
                            <TextBlock Text="Other participants (what plays through your speakers or headset)" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="{Binding RecordSystemAudio}" IsEnabled="{Binding IsIdle}"
                                  VerticalAlignment="Center" MinWidth="0" ToolTip="Record system audio" />

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Scopes}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SystemAudioScope}" IsEnabled="{Binding IsIdle}" />

                            <ComboBox Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding SystemAudioDevices}" SelectedItem="{Binding SelectedSystemAudioDevice}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding IsIdle}"
                                      Visibility="{Binding IsDeviceScope, Converter={StaticResource BoolToVisibility}}" />

                            <DockPanel Margin="0,8,0,0" Visibility="{Binding IsAppScope, Converter={StaticResource BoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshAppsCommand}" Padding="8,5" Margin="6,0,0,0"
                                        ToolTip="Refresh running apps">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE72C;" />
                                </Button>
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                                          DisplayMemberPath="DisplayName" IsEnabled="{Binding IsIdle}" />
                            </DockPanel>
                        </StackPanel>

                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource LevelMeter}" Value="{Binding SystemAudioLevel}" />

                        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Volume" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemAudioGain, StringFormat={}{0:P0}}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                    Value="{Binding SystemAudioGain}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Microphone -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE720;" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Microphone" />
                            <TextBlock Text="Your voice" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="{Binding RecordMicrophone}" IsEnabled="{Binding IsIdle}"
                                  VerticalAlignment="Center" MinWidth="0" ToolTip="Record microphone" />

                        <ComboBox Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                  DisplayMemberPath="Name" IsEnabled="{Binding IsIdle}" />

                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource LevelMeter}" Value="{Binding MicrophoneLevel}" />

                        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Volume" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsMicrophoneMuted}" Padding="8,4" Margin="8,0,0,0">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="ToolTip" Value="Mute in recording (does not mute your meeting app)" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="ToolTip" Value="Unmute" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <TextBlock FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE720;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                                                    <Setter Property="Text" Value="&#xEC54;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToggleButton>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MicrophoneGain, StringFormat={}{0:P0}}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                    Value="{Binding MicrophoneGain}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Output" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" Padding="8,5" Margin="6,0,0,0" ToolTip="Open folder">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE838;" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseFolderCommand}" Padding="8,5" Margin="6,0,0,0" ToolTip="Change folder">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8B7;" />
                            </Button>
                            <TextBox Text="{Binding OutputFolder, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="Format" VerticalAlignment="Center" Margin="0,12,16,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Formats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Format}" IsEnabled="{Binding IsIdle}" />

                        <TextBlock Grid.Row="2" Text="Bitrate" VerticalAlignment="Center" Margin="0,12,16,0"
                                   Visibility="{Binding IsM4a, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Bitrates}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Bitrate}" IsEnabled="{Binding IsIdle}"
                                  Visibility="{Binding IsM4a, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,4,0,0"
                           Text="Tip: with speakers, the microphone also picks up other participants, so use a headset." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
