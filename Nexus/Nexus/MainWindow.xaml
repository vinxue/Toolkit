<Window x:Class="Nexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nexus"
        mc:Ignorable="d"
        Title="Nexus" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid x:Name="KeyboardFocusHost" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: pushes the content column aside when expanded. This is a
             deliberate choice over a floating/overlay sidebar: WebView2 renders in its
             own native child window, which always paints on top of WPF content
             regardless of Z-order, so a WPF sidebar cannot visually overlap it. -->
        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Width="52"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource SidebarBorder}"
                BorderThickness="0,0,1,0">

            <DockPanel LastChildFill="True">

                <!-- Header: hamburger toggle -->
                <Grid DockPanel.Dock="Top" Height="52">
                    <Button x:Name="ToggleButton"
                            Style="{StaticResource IconButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="40" Height="40"
                            HorizontalAlignment="Left"
                            Margin="6,0,0,0"
                            Content="&#xE700;"
                            ToolTip="Expand / collapse"
                            Click="ToggleButton_Click" />
                </Grid>

                <!-- Footer: settings -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource SidebarBorder}"
                        BorderThickness="0,1,0,0">
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource IconButton}"
                            Height="40"
                            Margin="6"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Click="SettingsButton_Click"
                            ToolTip="Settings">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16"
                                       Width="40"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Settings"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource SidebarText}"
                                       Visibility="{Binding IsSidebarExpanded,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Site list -->
                <ListBox x:Name="SiteList"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="SiteList_SelectionChanged"
                         PreviewMouseLeftButtonDown="SiteList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="SiteList_PreviewMouseMove"
                         DragOver="SiteList_DragOver"
                         Drop="SiteList_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="{StaticResource SidebarText}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="40">
                                            <Border x:Name="SelectionBackground"
                                                    Background="Transparent" />
                                            <Border x:Name="HoverBackground"
                                                    Width="40"
                                                    Height="40"
                                                    Margin="6,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="6"
                                                    Background="{StaticResource SidebarHover}"
                                                    Visibility="Collapsed" />
                                            <Border x:Name="ExpandedHoverBackground"
                                                    Background="{StaticResource SidebarHover}"
                                                    Visibility="Collapsed" />
                                            <Border x:Name="SelectionIndicator"
                                                    Width="3"
                                                    Height="40"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="1.5"
                                                    Background="{StaticResource AccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Visible" />
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                    <Condition Property="Tag" Value="Expanded" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="ExpandedHoverBackground" Property="Visibility"
                                                        Value="Visible" />
                                            </MultiTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBackground" Property="Background"
                                                        Value="{StaticResource SidebarSelected}" />
                                                <Setter TargetName="SelectionIndicator" Property="Visibility"
                                                        Value="Visible" />
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="ExpandedHoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Tag" Value="Expanded" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" ToolTip="{Binding Name}">
                                <Grid x:Name="CollapsedSiteItem">
                                    <Border Width="40" Height="40"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left">
                                        <Grid Width="32" Height="32"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              UseLayoutRounding="True">
                                            <Border x:Name="CollapsedAvatar"
                                                    CornerRadius="16"
                                                    Background="{StaticResource AvatarChipBackground}"
                                                    BorderBrush="{StaticResource AvatarChipBorder}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="CollapsedInitial"
                                                           Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                            </Border>
                                            <!-- 16px matches the size most sites ship, so the
                                                 icon is never scaled up. -->
                                            <Image x:Name="CollapsedFavicon"
                                                   Source="{Binding Favicon}"
                                                   Width="16" Height="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid x:Name="ExpandedSiteItem" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left">
                                        <Grid Width="32" Height="32"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              UseLayoutRounding="True">
                                            <Border x:Name="ExpandedAvatar"
                                                    CornerRadius="16"
                                                    Background="{StaticResource AvatarChipBackground}"
                                                    BorderBrush="{StaticResource AvatarChipBorder}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="ExpandedInitial"
                                                           Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                            </Border>
                                            <Image x:Name="ExpandedFavicon"
                                                   Source="{Binding Favicon}"
                                                   Width="16" Height="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,4,0"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SidebarText}" />

                                    <TextBlock Grid.Column="2"
                                               Text="&#xE72E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{StaticResource SidebarText}"
                                               FontSize="12"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               ToolTip="Uses isolated profile"
                                               Visibility="{Binding UsesIsolatedProfile,
                                                   Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                    <Setter TargetName="CollapsedFavicon" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ExpandedFavicon" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CollapsedInitial" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ExpandedInitial" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="CollapsedAvatar" Property="Background" Value="{StaticResource AvatarBackground}" />
                                    <Setter TargetName="ExpandedAvatar" Property="Background" Value="{StaticResource AvatarBackground}" />
                                    <Setter TargetName="CollapsedAvatar" Property="BorderThickness" Value="0" />
                                    <Setter TargetName="ExpandedAvatar" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="CollapsedSiteItem" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ExpandedSiteItem" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TemporaryAddressBar"
                    Grid.Row="0"
                    Background="#F6F8FB"
                    BorderBrush="#D8DEE8"
                    BorderThickness="0,0,0,1"
                    Padding="16,12"
                    Visibility="Collapsed">
                <Border HorizontalAlignment="Stretch"
                        Background="#E8EDF5"
                        CornerRadius="10"
                        Padding="1">
                    <Grid>
                        <TextBox x:Name="TemporaryAddressBox"
                                 Style="{StaticResource TemporaryAddressTextBox}"
                                 Height="38"
                                 TextChanged="TemporaryAddressBox_TextChanged"
                                 KeyDown="TemporaryAddressBox_KeyDown" />
                        <TextBlock x:Name="TemporaryAddressPlaceholderText"
                                   Text="Enter web address"
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   Margin="13,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Border>

            <!-- Web content host -->
            <Grid x:Name="WebHost" Grid.Row="1" Background="#FFFFFF">
                <TextBlock x:Name="EmptyHint"
                           Text="Select a site from the left to get started."
                           Foreground="#8A94A6"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <StackPanel x:Name="LoadingHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <!-- WPF has no ProgressRing: a dashed ellipse renders as an arc,
                         and rotating it gives the same spinner. -->
                    <Ellipse Width="28"
                             Height="28"
                             StrokeThickness="3"
                             Stroke="{StaticResource AccentBrush}"
                             StrokeDashArray="20 10"
                             StrokeDashCap="Round"
                             HorizontalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:1.1"
                                                        RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Loading..."
                               Foreground="#8A94A6"
                               FontSize="14"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ErrorHint"
                           Foreground="#DC2626"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
