<Window x:Class="Nexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nexus"
        mc:Ignorable="d"
        Title="Nexus" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid x:Name="KeyboardFocusHost" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: pushes the content column aside when expanded. This is a
             deliberate choice over a floating/overlay sidebar: WebView2 renders in its
             own native child window, which always paints on top of WPF content
             regardless of Z-order, so a WPF sidebar cannot visually overlap it. -->
        <Grid x:Name="SidebarPanel"
              Grid.Column="0"
              Width="49"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0"
                       LastChildFill="True"
                       Background="{StaticResource SidebarBackground}">

                <!-- Header: hamburger toggle -->
                <Grid DockPanel.Dock="Top" Height="48">
                    <Grid Width="48" HorizontalAlignment="Left">
                        <Button x:Name="ToggleButton"
                                Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Width="40" Height="40"
                                HorizontalAlignment="Center"
                                Content="&#xE700;"
                                ToolTip="Expand / collapse"
                                Click="ToggleButton_Click" />
                    </Grid>
                </Grid>

                <!-- Footer: settings -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource SidebarBorder}"
                        BorderThickness="0,1,0,0">
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource SidebarFooterButton}"
                            Height="40"
                            Margin="0,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Click="SettingsButton_Click"
                            ToolTip="Settings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Settings"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource SidebarText}"
                                       Visibility="{Binding IsSidebarExpanded,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                </Border>

                <!-- Site list -->
                <ListBox x:Name="SiteList"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="SiteList_SelectionChanged"
                         PreviewMouseLeftButtonDown="SiteList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="SiteList_PreviewMouseMove"
                         DragOver="SiteList_DragOver"
                         Drop="SiteList_Drop">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False"
                                          Padding="0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <!-- Overlay scroll bar: a docked one would steal width from
                                     the 48px rail and push the avatars off centre. -->
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                    Content="{TemplateBinding Content}"
                                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                    Margin="{TemplateBinding Padding}" />
                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                                       Orientation="Vertical"
                                                       HorizontalAlignment="Right"
                                                       Cursor="Arrow"
                                                       Minimum="0"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Value="{TemplateBinding VerticalOffset}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="{StaticResource SidebarText}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="40">
                                            <Border x:Name="SelectionBackground"
                                                    Background="Transparent" />
                                            <Border x:Name="HoverBackground"
                                                    Width="40"
                                                    Height="40"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="6"
                                                    Background="{StaticResource SidebarHover}"
                                                    Visibility="Collapsed" />
                                            <Border x:Name="ExpandedHoverBackground"
                                                    Background="{StaticResource SidebarHover}"
                                                    Visibility="Collapsed" />
                                            <Border x:Name="SelectionIndicator"
                                                    Width="3"
                                                    Height="40"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="1.5"
                                                    Background="{StaticResource AccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Visible" />
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                    <Condition Property="Tag" Value="Expanded" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="ExpandedHoverBackground" Property="Visibility"
                                                        Value="Visible" />
                                            </MultiTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBackground" Property="Background"
                                                        Value="{StaticResource SidebarSelected}" />
                                                <Setter TargetName="SelectionIndicator" Property="Visibility"
                                                        Value="Visible" />
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="ExpandedHoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Tag" Value="Expanded" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" ToolTip="{Binding Name}">
                                <Grid x:Name="CollapsedSiteItem">
                                    <Border Width="40" Height="40"
                                            HorizontalAlignment="Center">
                                        <Grid Width="32" Height="32"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              UseLayoutRounding="True">
                                            <Border x:Name="CollapsedAvatar"
                                                    CornerRadius="16"
                                                    Background="{StaticResource AvatarChipBackground}"
                                                    BorderBrush="{StaticResource AvatarChipBorder}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="CollapsedInitial"
                                                           Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                            </Border>
                                            <!-- 16px matches the size most sites ship, so the
                                                 icon is never scaled up. -->
                                            <Image x:Name="CollapsedFavicon"
                                                   Source="{Binding Favicon}"
                                                   Width="16" Height="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid x:Name="ExpandedSiteItem" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            HorizontalAlignment="Center">
                                        <Grid Width="32" Height="32"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              UseLayoutRounding="True">
                                            <Border x:Name="ExpandedAvatar"
                                                    CornerRadius="16"
                                                    Background="{StaticResource AvatarChipBackground}"
                                                    BorderBrush="{StaticResource AvatarChipBorder}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="ExpandedInitial"
                                                           Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                            </Border>
                                            <Image x:Name="ExpandedFavicon"
                                                   Source="{Binding Favicon}"
                                                   Width="16" Height="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,4,0"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SidebarText}" />

                                    <Grid Grid.Column="2"
                                          Width="46"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE72E;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="{StaticResource SidebarText}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Uses isolated profile"
                                                   Visibility="{Binding UsesIsolatedProfile,
                                                       Converter={StaticResource BoolToVis}}" />

                                        <Button Grid.Column="1"
                                                Style="{StaticResource RemoveSiteButton}"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                Width="26"
                                                Height="26"
                                                FontSize="12"
                                                Content="&#xE711;"
                                                ToolTip="Remove this site"
                                                Click="DeleteSite_Click" />
                                    </Grid>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                    <Setter TargetName="CollapsedFavicon" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ExpandedFavicon" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CollapsedInitial" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ExpandedInitial" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="CollapsedAvatar" Property="Background" Value="{StaticResource AvatarBackground}" />
                                    <Setter TargetName="ExpandedAvatar" Property="Background" Value="{StaticResource AvatarBackground}" />
                                    <Setter TargetName="CollapsedAvatar" Property="BorderThickness" Value="0" />
                                    <Setter TargetName="ExpandedAvatar" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="CollapsedSiteItem" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ExpandedSiteItem" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border x:Name="SidebarDivider"
                    Grid.Column="1"
                    Background="{StaticResource SidebarBorder}" />
        </Grid>

        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TemporaryAddressBar"
                    Grid.Row="0"
                    Background="#F6F8FB"
                    BorderBrush="#D8DEE8"
                    BorderThickness="0,0,0,1"
                    Padding="16,12"
                    Visibility="Collapsed">
                <Border HorizontalAlignment="Stretch"
                        Background="#E8EDF5"
                        CornerRadius="10"
                        Padding="1">
                    <Grid>
                        <TextBox x:Name="TemporaryAddressBox"
                                 Style="{StaticResource TemporaryAddressTextBox}"
                                 Height="38"
                                 TextChanged="TemporaryAddressBox_TextChanged"
                                 KeyDown="TemporaryAddressBox_KeyDown" />
                        <TextBlock x:Name="TemporaryAddressPlaceholderText"
                                   Text="Enter web address"
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   Margin="13,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Border>

            <!-- Web content host -->
            <Grid x:Name="WebHost" Grid.Row="1" Background="#FFFFFF">
                <TextBlock x:Name="EmptyHint"
                           Text="Select a site from the left to get started."
                           Foreground="#8A94A6"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <StackPanel x:Name="LoadingHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <!-- WPF has no ProgressRing: a dashed ellipse renders as an arc,
                         and rotating it gives the same spinner. -->
                    <Ellipse Width="28"
                             Height="28"
                             StrokeThickness="3"
                             Stroke="{StaticResource AccentBrush}"
                             StrokeDashArray="20 10"
                             StrokeDashCap="Round"
                             HorizontalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:1.1"
                                                        RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Loading..."
                               Foreground="#8A94A6"
                               FontSize="14"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ErrorHint"
                           Foreground="#DC2626"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
