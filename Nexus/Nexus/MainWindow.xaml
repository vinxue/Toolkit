<Window x:Class="Nexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nexus"
        mc:Ignorable="d"
        Title="Nexus" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid x:Name="KeyboardFocusHost" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: pushes the content column aside when expanded. This is a
             deliberate choice over a floating/overlay sidebar: WebView2 renders in its
             own native child window, which always paints on top of WPF content
             regardless of Z-order, so a WPF sidebar cannot visually overlap it. -->
        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Width="52"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource SidebarBorder}"
                BorderThickness="0,0,1,0">

            <DockPanel LastChildFill="True">

                <!-- Header: hamburger toggle -->
                <Grid DockPanel.Dock="Top" Height="52">
                    <Button x:Name="ToggleButton"
                            Style="{StaticResource IconButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="40" Height="40"
                            HorizontalAlignment="Left"
                            Margin="6,0,0,0"
                            Content="&#xE700;"
                            ToolTip="Expand / collapse"
                            Click="ToggleButton_Click" />
                </Grid>

                <!-- Footer: add site -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource SidebarBorder}"
                        BorderThickness="0,1,0,0">
                    <Button x:Name="AddSiteButton"
                            Style="{StaticResource IconButton}"
                            Height="40"
                            Margin="6"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Click="AddSiteButton_Click"
                            ToolTip="Add a website">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18"
                                       Width="40"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Add site"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource SidebarText}"
                                       Visibility="{Binding IsSidebarExpanded,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Site list -->
                <ListBox x:Name="SiteList"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="SiteList_SelectionChanged"
                         PreviewMouseLeftButtonDown="SiteList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="SiteList_PreviewMouseMove"
                         DragOver="SiteList_DragOver"
                         Drop="SiteList_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="{StaticResource SidebarText}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="40">
                                            <Border x:Name="SelectionBackground"
                                                    Background="Transparent" />
                                            <Border x:Name="HoverBackground"
                                                    Width="40"
                                                    Height="40"
                                                    Margin="6,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="6"
                                                    Background="{StaticResource SidebarHover}"
                                                    Visibility="Collapsed" />
                                            <Border x:Name="ExpandedHoverBackground"
                                                    Background="{StaticResource SidebarHover}"
                                                    Visibility="Collapsed" />
                                            <Border x:Name="SelectionIndicator"
                                                    Width="3"
                                                    Height="40"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="1.5"
                                                    Background="{StaticResource AccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Visible" />
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                    <Condition Property="Tag" Value="Expanded" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="ExpandedHoverBackground" Property="Visibility"
                                                        Value="Visible" />
                                            </MultiTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBackground" Property="Background"
                                                        Value="{StaticResource SidebarSelected}" />
                                                <Setter TargetName="SelectionIndicator" Property="Visibility"
                                                        Value="Visible" />
                                                <Setter TargetName="HoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="ExpandedHoverBackground" Property="Visibility"
                                                        Value="Collapsed" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Tag" Value="Expanded" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" ToolTip="{Binding Name}">
                                <Grid x:Name="CollapsedSiteItem">
                                    <Border Width="40" Height="40"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left">
                                        <Border Width="32" Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="16"
                                                Background="{StaticResource AvatarBackground}">
                                            <TextBlock Text="{Binding Initial}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                </Grid>

                                <Grid x:Name="ExpandedSiteItem" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left">
                                        <Border Width="32" Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="16"
                                                Background="{StaticResource AvatarBackground}">
                                            <TextBlock Text="{Binding Initial}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,4,0"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SidebarText}" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource RemoveSiteButton}"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Width="26" Height="26"
                                            FontSize="12"
                                            Margin="0,0,6,0"
                                            Content="&#xE711;"
                                            ToolTip="Remove this site"
                                            Click="DeleteSite_Click" />
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="CollapsedSiteItem" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ExpandedSiteItem" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TemporaryAddressBar"
                    Grid.Row="0"
                    Background="#F6F8FB"
                    BorderBrush="#D8DEE8"
                    BorderThickness="0,0,0,1"
                    Padding="16,12"
                    Visibility="Collapsed">
                <Border HorizontalAlignment="Stretch"
                        Background="#E8EDF5"
                        CornerRadius="10"
                        Padding="1">
                    <Grid>
                        <TextBox x:Name="TemporaryAddressBox"
                                 Style="{StaticResource TemporaryAddressTextBox}"
                                 Height="38"
                                 TextChanged="TemporaryAddressBox_TextChanged"
                                 KeyDown="TemporaryAddressBox_KeyDown" />
                        <TextBlock x:Name="TemporaryAddressPlaceholderText"
                                   Text="Enter web address"
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   Margin="13,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Border>

            <!-- Web content host -->
            <Grid x:Name="WebHost" Grid.Row="1" Background="#FFFFFF">
                <TextBlock x:Name="EmptyHint"
                           Text="Select a site from the left to get started."
                           Foreground="#8A94A6"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="LoadingHint"
                           Text="Loading..."
                           Foreground="#8A94A6"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ErrorHint"
                           Foreground="#DC2626"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
