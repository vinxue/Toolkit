<UserControl x:Class="Nexus.Controls.CaptionButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nexus.Controls"
             Focusable="False">
    <UserControl.Resources>
        <!-- All states are style triggers on Background/Foreground so the close button can
             override them; the IsNonClient* triggers mirror the native maximize button. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <Trigger Property="local:CaptionButtons.IsNonClientHover" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="local:CaptionButtons.IsNonClientPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Windows 11 close button colors, identical in light and dark themes. -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E6C42B1C" />
                    <Setter Property="Foreground" Value="#B3FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Button x:Name="MinimizeButton"
                Style="{StaticResource CaptionButtonStyle}"
                Content="&#xE921;"
                ToolTip="Minimize"
                AutomationProperties.Name="Minimize"
                Click="MinimizeButton_Click" />
        <!-- No ToolTip: the pointer never reaches WPF here, Windows shows Snap Layouts instead. -->
        <Button x:Name="MaximizeButton"
                Style="{StaticResource CaptionButtonStyle}"
                Content="&#xE922;"
                AutomationProperties.Name="Maximize"
                Click="MaximizeButton_Click" />
        <Button x:Name="CloseButton"
                Style="{StaticResource CloseButtonStyle}"
                Content="&#xE8BB;"
                ToolTip="Close"
                AutomationProperties.Name="Close"
                Click="CloseButton_Click" />
    </StackPanel>
</UserControl>
