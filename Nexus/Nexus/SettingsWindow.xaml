<Window x:Class="Nexus.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Nexus.Models"
        Title="Settings"
        Width="800"
        Height="540"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SettingsNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                            Height="40">
                            <Grid>
                                <Border x:Name="SelectionIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="1.5"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="14,0,10,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{StaticResource SidebarHover}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{StaticResource SidebarSelected}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#12000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B6B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F1F1F" />
        </Style>

        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B6B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A4A4A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" />
                                <!-- Win11 marks focus with an accent underline rather than
                                     recolouring the whole outline. -->
                                <Border x:Name="FocusUnderline"
                                        Height="2"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="0,0,3,3"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusUnderline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#9A9A9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,4,0,4">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Height="0"
                                                  MinHeight="0"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="44">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#BABBBE"
                                                        CornerRadius="3"
                                                        Margin="2,1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#888888" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#555555" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Height="0"
                                                  MinHeight="0"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Width="0"
                                                          MinWidth="0"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          Opacity="0" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="44">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder"
                                                                Background="#C0C0C0"
                                                                CornerRadius="3"
                                                                Margin="1,2" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#888888" />
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#555555" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Width="0"
                                                          MinWidth="0"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          Opacity="0" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8E8E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCDCDC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#F3F3F3"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0"
                Padding="0,18">
            <DockPanel LastChildFill="True">
                <StackPanel Margin="0,10,0,0">
                    <Button x:Name="SitesNavButton"
                            Style="{StaticResource SettingsNavButton}"
                            Tag="Selected"
                            Click="SitesNavButton_Click">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                            <TextBlock Text="&#xE774;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15"
                                       Width="24"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Sites" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ProfilesNavButton"
                            Style="{StaticResource SettingsNavButton}"
                            Margin="0,4,0,0"
                            Click="ProfilesNavButton_Click">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15"
                                       Width="24"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Profiles" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="AboutNavButton"
                            Style="{StaticResource SettingsNavButton}"
                            Margin="0,4,0,0"
                            Click="AboutNavButton_Click">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15"
                                       Width="24"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="About &amp; help" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,32,28">
                <Grid x:Name="SitesPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Sites" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Add and manage websites in your workspace."
                                   Style="{StaticResource PageSubtitle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            x:Name="SiteFormCard"
                            Style="{StaticResource SettingsCard}"
                            Margin="0,0,0,18"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="3"
                                       x:Name="SiteFormTitle"
                                       Text="Add site"
                                       Style="{StaticResource CardTitle}"
                                       Margin="0,0,0,14" />
                            <TextBlock Grid.Row="1" Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="URL" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox"
                                     Grid.Row="2"
                                     Style="{StaticResource SettingsTextBox}" />
                            <TextBox x:Name="UrlBox"
                                     Grid.Row="2"
                                     Grid.Column="2"
                                     Style="{StaticResource SettingsTextBox}"
                                     Text="https://" />
                            <CheckBox x:Name="UseIsolatedProfileBox"
                                      Grid.Row="3"
                                      Grid.ColumnSpan="3"
                                      Content="Use an isolated profile for this site"
                                      Margin="0,14,0,0" />
                            <Grid Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AddErrorText"
                                           Foreground="#C42B1C"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="CancelEditButton"
                                        Content="Cancel"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Click="CancelEdit_Click" />
                                    <Button x:Name="SaveSiteButton"
                                        Content="Add site"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="SaveSite_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SettingsCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pinned sites"
                                           Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="AddSiteButton"
                                        Grid.Column="1"
                                        Content="Add site"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="AddSite_Click" />
                            </Grid>
                            <ListBox x:Name="SitesList"
                                     Grid.Row="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     Margin="-18,0,-18,-18">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBackground"
                                                            Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBackground" Property="Background" Value="#F5F5F5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SiteConfig}">
                                        <Border BorderBrush="#ECECEC"
                                                BorderThickness="0,0,0,1"
                                                Padding="18,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Padding="0,3">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#1F1F1F"
                                                                       FontSize="14"
                                                                       LineHeight="18"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <Border Background="#F3F3F3"
                                                                    BorderBrush="#E5E5E5"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="7,1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProfileMode}"
                                                                           Foreground="#5A5A5A"
                                                                           FontSize="10" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Url}"
                                                                   Foreground="#6B6B6B"
                                                                   FontSize="12"
                                                                   LineHeight="16"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Margin="12,0,0,0">
                                                    <Button Style="{StaticResource SettingsIconButton}"
                                                            Content="&#xE70F;"
                                                            Tag="{Binding}"
                                                            ToolTip="Edit site"
                                                            Click="EditSite_Click" />
                                                    <Button Style="{StaticResource SettingsIconButton}"
                                                            Content="&#xE74D;"
                                                            Margin="6,0,0,0"
                                                            Tag="{Binding}"
                                                            ToolTip="Remove site"
                                                            Click="RemoveSite_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ProfilesPage" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Each profile is a separate identity: its own sign-ins, cookies and cache."
                                       Style="{StaticResource PageSubtitle}" />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Data to clear" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Pick the data types here, then clear them for a profile below."
                                           Style="{StaticResource CardCaption}"
                                           Margin="0,4,0,14" />

                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ClearCacheBox"
                                              Content="Cached images and files"
                                              IsChecked="True"
                                              Width="250"
                                              MinHeight="30" />
                                    <CheckBox x:Name="ClearCookiesBox"
                                              Content="Cookies and sign-in data"
                                              Width="250"
                                              MinHeight="30" />
                                    <CheckBox x:Name="ClearSiteStorageBox"
                                              Content="Site storage"
                                              Width="250"
                                              MinHeight="30" />
                                    <CheckBox x:Name="ClearBrowsingHistoryBox"
                                              Content="Browsing history"
                                              Width="250"
                                              MinHeight="30" />
                                    <CheckBox x:Name="ClearDownloadHistoryBox"
                                              Content="Download history"
                                              Width="250"
                                              MinHeight="30" />
                                    <CheckBox x:Name="ClearAutofillBox"
                                              Content="Autofill and saved passwords"
                                              Width="250"
                                              MinHeight="30" />
                                    <CheckBox x:Name="ClearSiteSettingsBox"
                                              Content="Site settings"
                                              Width="250"
                                              MinHeight="30" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Shared profile" Style="{StaticResource CardTitle}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SharedProfileUsageText"
                                               Style="{StaticResource CardCaption}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Clear"
                                            Style="{StaticResource SettingsActionButton}"
                                            Margin="20,0,0,0"
                                            Click="ClearSharedData_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="IsolatedProfilesCard"
                                Style="{StaticResource SettingsCard}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Isolated profiles" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Sites that keep a separate identity from everything else."
                                           Style="{StaticResource CardCaption}"
                                           Margin="0,4,0,0" />

                                <ItemsControl x:Name="IsolatedProfilesList" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SiteConfig}">
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#1F1F1F"
                                                               FontSize="13" />
                                                    <TextBlock Text="{Binding ProfileName}"
                                                               Foreground="#8A8A8A"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Clear"
                                                        Style="{StaticResource SettingsActionButton}"
                                                        Margin="20,0,0,0"
                                                        Tag="{Binding}"
                                                        Click="ClearSiteData_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Private windows" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Ctrl+Shift+N opens a window that keeps nothing on disk, so there is nothing to clear. Temporary pages and ordinary new windows use the shared profile."
                                           Style="{StaticResource CardCaption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Data folder" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Holds sites.json and every WebView2 profile. Copy sites.json to back up or move your site list."
                                               Style="{StaticResource CardCaption}"
                                               Margin="0,4,0,6" />
                                    <TextBox x:Name="DataFolderText"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#4A4A4A"
                                             FontSize="12"
                                             Padding="0"
                                             TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Open folder"
                                        Style="{StaticResource SettingsActionButton}"
                                        VerticalAlignment="Bottom"
                                        Margin="20,0,0,0"
                                        Click="OpenDataFolder_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="About &amp; help" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Nexus keeps your frequently used websites organized in a compact, focused workspace."
                                       Style="{StaticResource PageSubtitle}" />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock x:Name="AppNameText"
                                           Text="Nexus"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="AppVersionText"
                                           Text="Version"
                                           Foreground="#6B6B6B"
                                           FontSize="13"
                                           Margin="0,14,0,0" />
                                <TextBlock x:Name="DotNetVersionText"
                                           Text=".NET"
                                           Foreground="#6B6B6B"
                                           FontSize="13"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="WebView2VersionText"
                                           Text="WebView2"
                                           Foreground="#6B6B6B"
                                           FontSize="13"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="CopyrightText"
                                           Text="Copyright"
                                           Foreground="#6B6B6B"
                                           FontSize="13"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2"
                                           Text="Keyboard shortcuts"
                                           Style="{StaticResource CardTitle}"
                                           Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Text="Open address bar" FontSize="13" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+L" Foreground="#6B6B6B" FontSize="13" HorizontalAlignment="Right" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2" Text="Open new window" FontSize="13" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+N" Foreground="#6B6B6B" FontSize="13" HorizontalAlignment="Right" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="3" Text="Open private window" FontSize="13" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl+Shift+N" Foreground="#6B6B6B" FontSize="13" HorizontalAlignment="Right" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="4" Text="Close temporary page or window" FontSize="13" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Ctrl+W" Foreground="#6B6B6B" FontSize="13" HorizontalAlignment="Right" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="5" Text="Toggle fullscreen" FontSize="13" Margin="0,12,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="F11" Foreground="#6B6B6B" FontSize="13" HorizontalAlignment="Right" Margin="0,12,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
